# Minimum app configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
OPENAI_API_KEY=sk-your-openai-key
NEXT_PUBLIC_APP_URL=http://localhost:3000
CRON_SECRET=replace-with-a-long-random-secret

# Optional chat provider. Embeddings always use OpenAI, including with Google chat.
AI_PROVIDER=openai
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
GOOGLE_GENERATIVE_AI_API_KEY=
GOOGLE_CHAT_MODEL=gemini-2.0-flash

# Optional retrieval and reranking
RAG_RETRIEVAL_MODE=vector
RERANK_PROVIDER=none
RERANK_LLM_MODEL=gpt-4o-mini
COHERE_API_KEY=
COHERE_RERANK_MODEL=rerank-multilingual-v3.0

# Optional limits and operational cost estimates
MAX_UPLOAD_BYTES=26214400
CHAT_REQUESTS_PER_MINUTE=20
CHAT_INPUT_COST_USD_PER_MILLION=0
CHAT_OUTPUT_COST_USD_PER_MILLION=0

# Optional admin access (comma-separated)
ADMIN_EMAILS=admin@example.com

# Optional demo and E2E credentials
DEMO_USER_EMAIL=demo@example.com
E2E_USER_EMAIL=demo@example.com
E2E_USER_PASSWORD=change-me

# Optional local MCP server (required only for npm run mcp)
MCP_USER_ID=00000000-0000-4000-8000-000000000000
